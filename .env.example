# ─────────────────────────────────────────────────────────────
# Kryber — environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ═══ EXTERNAL API KEYS (required for real transcription + analysis) ═══
# These two use their conventional names (NO KRYBER_ prefix).
# They are read ONLY by the backend — never shipped to the frontend.
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=

# ── Core ────────────────────────────────────────────────────
KRYBER_ENVIRONMENT=development
KRYBER_LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────
# Production: PostgreSQL
KRYBER_DATABASE_URL=postgresql+psycopg://kryber:kryber@localhost:5432/kryber
# Local dev without Docker (fallback):
# KRYBER_DATABASE_URL=sqlite:///./kryber.db

# ── Redis (job queue) ───────────────────────────────────────
KRYBER_REDIS_URL=redis://localhost:6379/0
# queue backend: "redis" or "memory" (memory = in-process, dev/tests only)
KRYBER_QUEUE_BACKEND=redis
# dev only: run a worker thread inside the API process (memory queue)
# KRYBER_INPROC_WORKER=1

# ── Storage (S3-compatible) ─────────────────────────────────
KRYBER_STORAGE_BACKEND=local
# LOCAL dev: point this somewhere persistent (not /tmp) so rendered Shorts
# survive restarts, e.g. /home/user/data/storage
KRYBER_STORAGE_LOCAL_ROOT=/tmp/kryber/storage
# KRYBER_STORAGE_BACKEND=s3
# KRYBER_S3_ENDPOINT_URL=https://s3.example.com
# KRYBER_S3_ACCESS_KEY=...
# KRYBER_S3_SECRET_KEY=...
# KRYBER_S3_BUCKET=kryber
# KRYBER_S3_REGION=us-east-1

# ── LLM provider (clip analysis + hooks) ────────────────────
# provider: gemini | mock
KRYBER_LLM_PROVIDER=gemini
KRYBER_GEMINI_MODEL=gemini-3.6-flash
KRYBER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ── Transcription ───────────────────────────────────────────
# provider: assemblyai | mock
KRYBER_TRANSCRIPTION_PROVIDER=assemblyai
KRYBER_ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
KRYBER_ASSEMBLYAI_POLL_TIMEOUT_SECONDS=600

# ── Clip engine tuning ──────────────────────────────────────
KRYBER_CLIP_MIN_DURATION=20
KRYBER_CLIP_MAX_DURATION=60
KRYBER_CLIP_MAX_CANDIDATES=10
KRYBER_CLIP_TARGET_COUNT=5

# ── Job / safety limits ─────────────────────────────────────
KRYBER_JOB_TIMEOUT_SECONDS=3600
KRYBER_MAX_VIDEO_DURATION_SECONDS=14400
KRYBER_RATE_LIMIT_JOBS_PER_MINUTE=6

# ── Media / ingestion ───────────────────────────────────────
# Leave unset to auto-detect (Docker image installs ffmpeg via apt).
# KRYBER_FFMPEG_BINARY=/usr/bin/ffmpeg
# KRYBER_FFPROBE_BINARY=/usr/bin/ffprobe
# KRYBER_YTDLP_BINARY=yt-dlp
KRYBER_YTDLP_FORMAT=bestvideo[height<=1080]+bestaudio/best[height<=1080]/best
KRYBER_INGESTION_TIMEOUT_SECONDS=600
KRYBER_INGESTION_RETRIES=3
KRYBER_INGESTION_MIN_INTERVAL_SECONDS=2
# ── YouTube sign-in workaround (optional, RUNTIME ONLY — never commit) ────
# Codespaces / datacenter IPs are often challenged with YouTube's
# "Sign in to confirm you're not a bot" check. Fix without committing secrets:
#   1. On your LOCAL PC (signed into YouTube) export a cookies.txt file
#      (Netscape format) with a browser extension, e.g. "Get cookies.txt
#      LOCALLY" or "cookie-editor".
#   2. Upload that file to your Codespace OUTSIDE the repository
#      (e.g. ~/cookies.txt). Cookie files are git-ignored; never commit them.
#   3. Set the path here (.env is git-ignored) or in Codespace env vars:
# KRYBER_YTDLP_COOKIES_FILE=/home/user/cookies.txt
# Leave unset for anonymous downloads (default). If the file goes stale,
# re-export it and update the file — no code changes needed.
# Optional yt-dlp player clients (comma-separated), e.g. "android,ios,tv":
# KRYBER_YTDLP_PLAYER_CLIENTS=

# ── Rendering ───────────────────────────────────────────────
KRYBER_RENDER_TIMEOUT_SECONDS=900
KRYBER_RENDER_PARALLELISM=2
# medium + CRF 23 ≈ half the size of veryfast + CRF 20, near-identical quality
KRYBER_RENDER_PRESET=medium
KRYBER_RENDER_CRF=23
KRYBER_RENDER_AUDIO_BITRATE=96k
# Captions are burned in with drawtext using the bundled font
# (backend/app/assets/fonts/DejaVuSans-Bold.ttf) — no fontconfig needed.
KRYBER_CAPTION_FONT_SIZE=88

# ── Temp working dir ────────────────────────────────────────
KRYBER_TMP_ROOT=/tmp/kryber

# ── CORS (frontend origins, comma-separated; "*" for dev) ───
KRYBER_CORS_ORIGINS=*

# ── Frontend ────────────────────────────────────────────────
# Used by Next.js server-side rewrites to reach the backend.
API_URL=http://localhost:8000
